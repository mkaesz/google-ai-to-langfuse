# --- Langfuse Cloud ---------------------------------------------------------
# Create a project at https://cloud.langfuse.com (EU) or
# https://us.cloud.langfuse.com (US), then: Project Settings -> API Keys.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# EU region. For US use https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Google Cloud / Vertex AI ----------------------------------------------
# GCP project with the Vertex AI API enabled. Auth via:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=europe-west4
